# Copy to .env and fill in. Never commit .env.

# Required
OPENAI_API_KEY=your-key-here
# Model ids as the OpenAI API names them. The generation model takes no temperature setting.
GENERATION_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small

# Optional tuning (defaults shown)
# TAGGING_THRESHOLD=0.35      # minimum cosine similarity for a source to get a topic tag
# MAX_TAGS_PER_SOURCE=3       # cap on tags per source
# TOP_K=8                     # sources per briefing
# PER_TOPIC_MIN=1             # minimum sources per persona topic, where available
# PASSAGE_THRESHOLD=0.30      # minimum similarity for a passage to reach the briefing
# MAX_PASSAGES_PER_SOURCE=4   # most passages taken from one source
# CUTOFF_DATE=2025-04-06     # sources dated before this are excluded
# LATEST_DATE=2025-05-06      # newest source date; later dates found in text are ignored
# SOURCES_PATH=sources_06-05-25.json
# TOPICS_PATH=topics.yaml
# PERSONAS_PATH=personas.yaml
# CACHE_PATH=.cache/embeddings
# LOG_LEVEL=INFO
