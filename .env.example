# Copy to .env and fill in. Never commit .env.

# Required
OPENAI_API_KEY=your-key-here
# Model ids as the OpenAI API names them. The generation model takes no temperature setting.
GENERATION_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small

# Optional tuning (defaults shown)
# TAGGING_THRESHOLD=0.30      # minimum cosine similarity for a source to get a topic tag
# MAX_TAGS_PER_SOURCE=4       # cap on tags per source
# TOP_K=10                    # sources per briefing
# PER_TOPIC_MIN=2             # minimum sources per persona topic, where available
# PASSAGE_THRESHOLD=0.40      # minimum similarity for a passage to be used for a topic
# MAX_PASSAGES_PER_TOPIC=7    # best passages each persona topic takes across the sources
# MAX_PASSAGES_PER_SOURCE=5   # most passages taken from any one source
# MAX_PASSAGES_PER_SOURCE_PER_TOPIC=2 # optional cap on one source's passages for one topic (unset: off)
# RECENCY_BONUS=0.15          # ranking boost for passages dated inside the window (0 turns it off)
# CUTOFF_DATE=2025-04-06     # sources dated before this are excluded
# LATEST_DATE=2025-05-06      # newest source date; later dates found in text are ignored
# SOURCES_PATH=sources_06-05-25.json
# TOPICS_PATH=topics.yaml
# PERSONAS_PATH=personas.yaml
# CACHE_PATH=.cache/embeddings
# OPENAI_TIMEOUT_SECONDS=60   # per-request timeout for OpenAI calls
# OPENAI_MAX_RETRIES=3        # retries (with backoff) on rate limits, timeouts and server errors
# LOG_LEVEL=INFO
