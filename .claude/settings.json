{
  "permissions": {
    "deny": [
      "Edit(.env)",
      "Edit(sources_06-05-25.json)",
      "Edit(task.md)",
      "Write(.env)",
      "Write(sources_06-05-25.json)",
      "Write(task.md)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Write(/.claude/settings.json)",
      "Write(/.claude/settings.local.json)",
      "Write(/.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_files.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/quality_gate.py\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
